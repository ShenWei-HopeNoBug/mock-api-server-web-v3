    "dayjs": "^1.11.21",
    "hash-sum": "^2.0.0",
    "json-editor-vue3": "^1.1.1",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "qs": "^6.15.3",
    "sortablejs": "^1.15.7",
    "uuid": "^14.0.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.0"
