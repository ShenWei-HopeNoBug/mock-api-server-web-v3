    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "sass": "^1.82.0",
    "terser": "^5.44.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.1",
